# ----- Server -----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ----- Third-party IPO data (optional) -----
# Preferred: IPO Guru — direct API, documented schema, lower latency than
# RapidAPI's proxy layer. Key is issued manually — email ipoguru.in@gmail.com
# with your name, app name, and use case. Free tier: 300 req/day, 15 req/min.
# https://www.ipoguru.in/ipo-gmp-details-developer-api
IPOGURU_API_KEY=

# Fallback / alternative: RapidAPI's indian-ipo-wallah.
RAPIDAPI_KEY=
RAPIDAPI_HOST=indian-ipo-wallah.p.rapidapi.com

# ----- Database -----
# Postgres connection string used by Prisma
DATABASE_URL="postgresql://ipo_user:ipo_password@localhost:5432/ipo_tracker?schema=public"

# ----- Auth -----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_this_password

# ----- Cron -----
ENABLE_CRON=true
GMP_CRON_SCHEDULE="*/30 * * * *"
STATUS_CRON_SCHEDULE="*/30 * * * *"
SUBSCRIPTION_CRON_SCHEDULE="*/30 * * * *"
UPCOMING_CRON_SCHEDULE="0 * * * *"
ARTICLES_CRON_SCHEDULE="0 * * * *"
REVIEWS_CRON_SCHEDULE="0 */3 * * *"

# ----- Rate limiting -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
