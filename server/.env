# ----- Server -----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ----- Third-party IPO data -----
# REQUIRED for live RapidAPI data. Without this, getActiveAdapters() in
# src/adapters/index.ts has no key to activate rapidApiIpoAdapter and falls
# back to mockSourceAdapter — this was the root cause of "no live data".
# Get your key from the RapidAPI dashboard for "Indian IPO Wallah":
# https://rapidapi.com/Dennis254/api/indian-ipo-wallah
RAPIDAPI_KEY=
RAPIDAPI_HOST=indian-ipo-wallah.p.rapidapi.com

# Optional: preferred GMP source (this RapidAPI provider has no GMP endpoint).
IPOGURU_API_KEY=

# ----- Database -----
# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:Samk%402026@localhost:5432/ipo_tracker?schema=public"

# ----- Auth -----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_this_password

# ----- Cron -----
ENABLE_CRON=true
GMP_CRON_SCHEDULE="*/30 * * * *"
STATUS_CRON_SCHEDULE="*/30 * * * *"
SUBSCRIPTION_CRON_SCHEDULE="*/30 * * * *"
UPCOMING_CRON_SCHEDULE="0 * * * *"
ARTICLES_CRON_SCHEDULE="0 * * * *"
REVIEWS_CRON_SCHEDULE="0 */3 * * *"

# ----- Rate limiting -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
