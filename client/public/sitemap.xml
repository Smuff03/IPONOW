<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static seed sitemap for local dev / initial deploy. In production, generate
  this dynamically from the database (server/src/routes/sitemap.ts can render
  /sitemap.xml by querying published IPO and Article slugs) so new IPO and
  article pages are included automatically without a manual rebuild.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://greenshoe.example.com/</loc><changefreq>hourly</changefreq><priority>1.0</priority></url>
  <url><loc>https://greenshoe.example.com/ipos</loc><changefreq>hourly</changefreq><priority>0.9</priority></url>
  <url><loc>https://greenshoe.example.com/allotment</loc><changefreq>daily</changefreq><priority>0.7</priority></url>
  <url><loc>https://greenshoe.example.com/reviews</loc><changefreq>daily</changefreq><priority>0.6</priority></url>
  <url><loc>https://greenshoe.example.com/articles</loc><changefreq>hourly</changefreq><priority>0.8</priority></url>
  <url><loc>https://greenshoe.example.com/about</loc><changefreq>monthly</changefreq><priority>0.3</priority></url>
  <url><loc>https://greenshoe.example.com/contact</loc><changefreq>monthly</changefreq><priority>0.3</priority></url>
</urlset>
